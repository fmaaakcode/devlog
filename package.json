{
  "name": "devlog",
  "version": "3.46.0",
  "description": "Project memory and guardrails for Claude Code via hooks and tags: rejected decisions, closed bugs with causes, release/install gates — local dashboard, zero telemetry",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "build": "bun build ./src/server.ts --compile --outfile devlog.exe",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "coverage:gate": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun scripts/coverage-gate.ts coverage/lcov.info",
    "doctor": "bun src/doctor.ts",
    "smoke:ui": "bun scripts/ui-smoke.ts",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "bun-types": "1.3.14",
    "typescript": "7.0.2"
  }
}
